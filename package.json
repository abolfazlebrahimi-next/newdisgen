{
  "name": "loco-town",
  "version": "1.0.0",
  "private": true,
  "description": "LOCO-style town screen built with Next.js + TypeScript on top of the Kenney 3D asset packs in this repository.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "assets:sync": "node scripts/sync-assets.mjs",
    "assets:measure": "node scripts/measure-models.mjs",
    "preview:render": "node scripts/render.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "prebuild": "node scripts/sync-assets.mjs",
    "smoke": "node --experimental-strip-types scripts/smoke-scene.mjs",
    "check": "tsc --noEmit && node --experimental-strip-types scripts/smoke-scene.mjs",
    "assets:status": "node scripts/sync-assets.mjs",
    "preview:pieces": "node scripts/piece-sheet.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}